{
  "author": "Timberline Ventures LLC (https://pourpicks.app/)",
  "cloudEndpoint": "https://nqnigdqkcvrziwcbgily.supabase.co/functions/v1/mcp",
  "description": "MCP server exposing the Pour Picks bourbon & whiskey database (4,700+ bottles) as read-only tools for AI assistants. Search the catalog, compare bottles, find cheaper alternatives, and get pour suggestions \u2014 with citation-ready attribution.",
  "homepage": "https://pourpicks.app/",
  "identifier": "bguillow-rgb-pour-picks-mcp",
  "name": "Pour Picks",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "model-context-protocol",
    "bourbon",
    "whiskey",
    "whisky",
    "spirits",
    "tasting-notes",
    "pour-picks"
  ],
  "tools": [
    {
      "name": "search_bottles",
      "description": "Full-text search across 4,700+ bourbons, ryes, scotches, and other spirits in the Pour Picks database. Filter by category, price (USD), and proof. Returns structured tasting profiles with source attribution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text search: distillery, bottle name, or expression"
          },
          "category": {
            "type": "string",
            "enum": [
              "bourbon",
              "rye",
              "tennessee",
              "wheat",
              "corn",
              "american_single_malt",
              "scotch_single_malt",
              "scotch_blend",
              "irish",
              "japanese",
              "canadian",
              "world_whisky",
              "rum",
              "tequila",
              "mezcal",
              "cognac",
              "armagnac",
              "brandy",
              "gin",
              "vodka",
              "other"
            ],
            "description": "Spirit category filter"
          },
          "price_min": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum price in USD"
          },
          "price_max": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum price in USD"
          },
          "proof_min": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum proof"
          },
          "proof_max": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum proof"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Max results (default 10)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_bottle",
      "description": "Detailed record for one bottle: tasting profile, flavor notes, pairings, price, community ratings. Accepts a Pour Picks bottle ID (UUID) or a bottle name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug_or_id": {
            "type": "string",
            "description": "Bottle UUID or a name like 'Eagle Rare 10'"
          }
        },
        "required": [
          "slug_or_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "find_similar",
      "description": "Bottles with a similar flavor profile to a given bottle, ranked by shared flavor notes and body/sweetness/char proximity. Deterministic scoring over the Pour Picks structured tasting data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bottle_id": {
            "type": "string",
            "description": "Bottle UUID or name"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "Max results (default 5)"
          }
        },
        "required": [
          "bottle_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "find_cheaper_alternative",
      "description": "Bottles in the same style with a similar flavor profile at a lower price than the given bottle. Great for 'what tastes like X without the price tag' questions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bottle_id": {
            "type": "string",
            "description": "Bottle UUID or name"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Max results (default 5)"
          }
        },
        "required": [
          "bottle_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_recommendations",
      "description": "Personalized bottle picks from taste preferences (flavor keywords like 'caramel', 'smoke', 'cherry'), a budget in USD, and an occasion (e.g. 'gift', 'everyday sipper', 'celebration', 'introducing a friend to bourbon').",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taste_preferences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Flavor keywords the drinker enjoys, e.g. ['caramel','vanilla','oak']"
          },
          "budget": {
            "type": "number",
            "minimum": 0,
            "description": "Max price in USD"
          },
          "occasion": {
            "type": "string",
            "description": "What the bottle is for"
          },
          "category": {
            "type": "string",
            "enum": [
              "bourbon",
              "rye",
              "tennessee",
              "wheat",
              "corn",
              "american_single_malt",
              "scotch_single_malt",
              "scotch_blend",
              "irish",
              "japanese",
              "canadian",
              "world_whisky",
              "rum",
              "tequila",
              "mezcal",
              "cognac",
              "armagnac",
              "brandy",
              "gin",
              "vodka",
              "other"
            ],
            "description": "Restrict to one spirit category"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Max results (default 5)"
          }
        },
        "required": [
          "taste_preferences"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "compare_bottles",
      "description": "Side-by-side comparison of two bottles: proof, age, price, flavor profile, shared and distinct tasting notes, and community ratings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bottle_a": {
            "type": "string",
            "description": "First bottle \u2014 UUID or name"
          },
          "bottle_b": {
            "type": "string",
            "description": "Second bottle \u2014 UUID or name"
          }
        },
        "required": [
          "bottle_a",
          "bottle_b"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "trending_bottles",
      "description": "Bottles Pour Picks users are adding to their cellars most over the last 30 days (falls back to catalog popularity when live activity data is unavailable). The method used is labeled in the response.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Max results (default 10)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "pour_tonight_suggestion",
      "description": "A pour suggestion for right now, based on mood (e.g. 'unwinding', 'celebratory', 'contemplative'), occasion (e.g. 'nightcap', 'with friends', 'after dinner'), and season.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mood": {
            "type": "string",
            "description": "How you're feeling"
          },
          "occasion": {
            "type": "string",
            "description": "The setting"
          },
          "season": {
            "type": "string",
            "enum": [
              "winter",
              "spring",
              "summer",
              "fall"
            ]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
  "version": "1.0.1"
}