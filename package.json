{
  "name": "pour-picks-mcp",
  "version": "1.0.1",
  "description": "MCP server exposing the Pour Picks bourbon & whiskey database (4,700+ bottles) as read-only tools for AI assistants. Search the catalog, compare bottles, find cheaper alternatives, and get pour suggestions \u2014 with citation-ready attribution.",
  "mcpName": "io.github.bguillow-rgb/pour-picks",
  "type": "module",
  "bin": {
    "pour-picks-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bourbon",
    "whiskey",
    "whisky",
    "spirits",
    "tasting-notes",
    "pour-picks"
  ],
  "author": "Timberline Ventures LLC (https://pourpicks.app/)",
  "license": "MIT",
  "homepage": "https://pourpicks.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bguillow-rgb/pour-picks-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/postgrest-js": "^2.109.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
